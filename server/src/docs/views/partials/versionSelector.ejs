<script>
  class VersionSelector {
    constructor(options = {}) {
      this.currentVersion =
        new URLSearchParams(window.location.search).get("version") || "latest";
      this.versions = [];
      this.packageName = "envlink";
      this.containerId = options.containerId || "version-selector";
      this.documentType = options.documentType || "README.md";
    }

    async fetchVersions() {
      try {
        const response = await fetch(
          `https://registry.npmjs.org/${this.packageName}`,
        );
        if (!response.ok)
          throw new Error(`Failed to fetch versions: ${response.status}`);

        const data = await response.json();
        const versions = Object.keys(data.versions || {});

        const filteredVersions = versions
          .filter((v) => !v.includes("-"))
          .filter((v) => {
            const parts = v.split(".").map(Number);
            if (parts.length < 3) return false;
            const [major, minor, patch] = parts;
            if (major > 2) return true;
            if (major === 2 && (minor > 0 || (minor === 0 && patch >= 4)))
              return true;
            return false;
          })
          .sort((a, b) => {
            const aParts = a.split(".").map(Number);
            const bParts = b.split(".").map(Number);
            for (let i = 0; i < 3; i++) {
              if (aParts[i] !== bParts[i]) return bParts[i] - aParts[i];
            }
            return 0;
          });

        this.versions = ["latest", ...filteredVersions];
        return this.versions;
      } catch (error) {
        console.error("Failed to fetch versions:", error);
        this.versions = ["latest"];
        return this.versions;
      }
    }

    createSelector(idPrefix = "") {
      if (this.versions.length <= 1) return "";

      const latestVersionNumber =
        this.versions.find((v) => v !== "latest") || "unknown";

      const selectId = idPrefix ? `${idPrefix}-dropdown` : "version-dropdown";
      const statusId = idPrefix ? `${idPrefix}-status` : "version-status";
      const isMobile = idPrefix.includes("mobile");

      if (isMobile) {
        return `
          <div class="version-selector-container p-3 mb-4 bg-github-header border border-github-border rounded-lg">
            <div class="flex items-center justify-between gap-3">
              <label for="${selectId}" class="text-xs font-semibold uppercase tracking-wider text-github-textMuted flex-shrink-0">Docs Version</label>
              <select id="${selectId}" class="flex-grow max-w-[200px] bg-github-bg border border-github-border rounded text-github-text text-xs px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-github-primary focus:border-github-primary">
                ${this.versions
                  .map(
                    (version) => `
                  <option value="${version}" ${version === this.currentVersion ? "selected" : ""}>
                    ${version} ${version === "latest" ? `(${latestVersionNumber})` : ""}
                  </option>
                `,
                  )
                  .join("")}
              </select>
            </div>
            <div class="text-[11px] text-github-textMuted mt-2 text-right">
              <span id="${statusId}">Documentation for ${this.currentVersion === "latest" ? "Latest" : `v${this.currentVersion}`}</span>
            </div>
          </div>
        `;
      }

      return `
        <div class="version-selector-container mt-6 pt-4 border-t border-github-border">
          <label for="${selectId}" class="block text-xs font-semibold uppercase tracking-wider text-github-textMuted mb-2">Version</label>
          <select id="${selectId}" class="w-full bg-github-bg border border-github-border rounded text-github-text text-xs px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-github-primary focus:border-github-primary">
            ${this.versions
              .map(
                (version) => `
              <option value="${version}" ${version === this.currentVersion ? "selected" : ""}>
                ${version} ${version === "latest" ? `(${latestVersionNumber})` : ""}
              </option>
            `,
              )
              .join("")}
          </select>
          <div class="text-xs text-github-textMuted mt-2">
            <span id="${statusId}">Documentation for ${this.currentVersion === "latest" ? "Latest" : `v${this.currentVersion}`}</span>
          </div>
        </div>
      `;
    }

    async init() {
      await this.fetchVersions();
      const targets = [this.containerId, `${this.containerId}-mobile`];

      targets.forEach((targetId) => {
        const container = document.getElementById(targetId);
        if (container) {
          container.innerHTML = this.createSelector(targetId);
          const selectId = `${targetId}-dropdown`;
          const dropdown = document.getElementById(selectId) || container.querySelector("select");
          if (dropdown) {
            dropdown.addEventListener("change", (e) => {
              const selectedVersion = e.target.value;
              const url = new URL(window.location);
              if (selectedVersion === "latest") {
                url.searchParams.delete("version");
              } else {
                url.searchParams.set("version", selectedVersion);
              }
              window.location.href = url.toString();
            });
          }
        }
      });
    }

    updateVersionStatus() {
      const displayVersion =
        this.currentVersion === "latest"
          ? "Latest"
          : `v${this.currentVersion}`;
      const statusElements = document.querySelectorAll('[id$="-status"]');
      statusElements.forEach((el) => {
        el.textContent = `Documentation for ${displayVersion}`;
      });
    }
  }

  window.VersionSelector = VersionSelector;
</script>
