<footer
  class="bg-github-header border-t border-github-border mt-10 sm:mt-16 py-8 sm:py-10 text-github-textMuted"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 sm:gap-8">
      <div>
        <div class="flex items-center gap-2 mb-3 sm:mb-4">
          <img
            src="<%= absoluteUrl('/image/logo.png') %>"
            alt="EnvLink Logo"
            class="w-5 h-5 object-contain rounded"
          />
          <h3 class="text-github-text text-sm sm:text-base font-semibold">
            EnvLink
          </h3>
        </div>
        <p class="mb-3 sm:mb-4 text-xs sm:text-sm leading-relaxed">
          Secure and anonymous environment file sharing CLI
        </p>
        <div class="flex gap-2.5 sm:gap-3">
          <a
            class="flex items-center gap-1.5 text-github-textMuted hover:text-github-text hover:border-github-textMuted hover:bg-github-hover no-underline text-xs sm:text-sm px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded border border-github-border transition-all duration-150"
            href="https://github.com/AbabilCore/envlink"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.185 6.839 9.504.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.203 22 16.447 22 12.021 22 6.484 17.523 2 12 2z"
              />
            </svg>
            GitHub
          </a>
          <a
            class="flex items-center gap-1.5 text-github-textMuted hover:text-github-text hover:border-github-textMuted hover:bg-github-hover no-underline text-xs sm:text-sm px-2.5 py-1.5 sm:px-3 sm:py-1.5 rounded border border-github-border transition-all duration-150"
            href="https://www.npmjs.com/package/envlink"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M0 0v24h24V0H0zm19.2 19.2H4.8V4.8h14.4v14.4zM8 8v8h4v-6h2v6h2V8H8z"
              />
            </svg>
            npm
          </a>
        </div>
      </div>

      <div>
        <h3
          class="text-github-text text-sm sm:text-base font-semibold mb-3 sm:mb-4"
        >
          Documentation
        </h3>
        <ul class="list-none m-0 p-0 space-y-2">
          <li>
            <a
              class="text-github-textMuted hover:text-github-primary no-underline text-xs sm:text-sm transition-colors duration-150"
              href="<%= absoluteUrl('/commands') %>"
              >Commands</a
            >
          </li>
          <li>
            <a
              class="text-github-textMuted hover:text-github-primary no-underline text-xs sm:text-sm transition-colors duration-150"
              href="<%= absoluteUrl('/faq') %>"
              >FAQ</a
            >
          </li>
          <li>
            <a
              class="text-github-textMuted hover:text-github-primary no-underline text-xs sm:text-sm transition-colors duration-150"
              href="<%= absoluteUrl('/self-host') %>"
              >Self-Host Guide</a
            >
          </li>
          <li>
            <a
              class="text-github-textMuted hover:text-github-primary no-underline text-xs sm:text-sm transition-colors duration-150"
              href="<%= absoluteUrl('/changelog') %>"
              >Changelog</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h3
          class="text-github-text text-sm sm:text-base font-semibold mb-3 sm:mb-4"
        >
          Resources
        </h3>
        <ul class="list-none m-0 p-0 space-y-2">
          <li>
            <a
              class="text-github-textMuted hover:text-github-primary no-underline text-xs sm:text-sm transition-colors duration-150"
              href="https://youtu.be/8d0pne95yAI?si=Q7Fs2a9rEKoFaUjI"
              target="_blank"
              rel="noopener noreferrer"
              >Tutorial Video*</a
            >
          </li>
          <li>
            <a
              class="text-github-textMuted hover:text-github-primary no-underline text-xs sm:text-sm transition-colors duration-150"
              href="https://tab.ababilspark.com/posts/how-i-designed-the-architecture-of-envlink"
              target="_blank"
              rel="noopener noreferrer"
              >EnvLink Internal Architecture</a
            >
          </li>
          <li>
            <a
              class="text-github-textMuted hover:text-github-primary no-underline text-xs sm:text-sm transition-colors duration-150"
              href="https://github.com/AbabilCore/envlink/issues"
              target="_blank"
              rel="noopener noreferrer"
              >Report Issues</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h3
          class="text-github-text text-sm sm:text-base font-semibold mb-3 sm:mb-4"
        >
          Statistics
        </h3>
        <div class="space-y-2.5 sm:space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-xs sm:text-sm text-github-textMuted"
              >Created</span
            >
            <span class="text-xs sm:text-sm font-mono text-github-primary"
              ><%= stats.total_created %></span
            >
          </div>
          <div class="flex justify-between items-center">
            <span class="text-xs sm:text-sm text-github-textMuted"
              >Installed</span
            >
            <span class="text-xs sm:text-sm font-mono text-github-primary"
              ><%= stats.total_installed %></span
            >
          </div>
          <div class="flex justify-between items-center">
            <span class="text-xs sm:text-sm text-github-textMuted"
              >Expired</span
            >
            <span class="text-xs sm:text-sm font-mono text-github-primary"
              ><%= stats.total_expired %></span
            >
          </div>
        </div>
      </div>

      <div>
        <h3
          class="text-github-text text-sm sm:text-base font-semibold mb-3 sm:mb-4"
        >
          Quick Start
        </h3>
        <div class="flex flex-col gap-2">
          <code
            class="bg-github-bg text-github-primaryMuted border border-github-border rounded px-2.5 py-1.5 sm:px-3 sm:py-2 text-[11px] sm:text-xs font-mono break-all"
            >npm install -g envlink</code
          >
          <code
            class="bg-github-bg text-github-primaryMuted border border-github-border rounded px-2.5 py-1.5 sm:px-3 sm:py-2 text-[11px] sm:text-xs font-mono break-all"
            >envlink create</code
          >
        </div>
      </div>
    </div>
  </div>
</footer>
