          class="flex items-center gap-1.5 text-xs text-github-textMuted px-2.5 py-1 rounded border border-github-border ml-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
