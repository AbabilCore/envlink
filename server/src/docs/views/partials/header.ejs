<header
  class="bg-github-header border-b border-github-border fixed top-0 left-0 right-0 z-50 w-full"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center gap-3">
        <a
          href="<%= absoluteUrl('/') %>"
          class="flex items-center gap-2 no-underline hover:opacity-80 transition-opacity duration-150"
        >
          <img
            src="<%= absoluteUrl('/image/logo.png') %>"
            alt="EnvLink Logo"
            class="w-6 h-6 object-contain rounded"
          />
          <span class="text-lg font-bold text-github-primary tracking-tight"
            >EnvLink</span
