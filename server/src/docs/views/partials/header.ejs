        </a>
        <span
          class="hidden sm:inline text-xs bg-github-code text-github-primary border border-github-primary border-opacity-40 rounded-full px-2 py-0.5"
        >
          <%= page === 'home' ? 'Home' : page === 'commands' ? 'Commands' : page
          === 'faq' ? 'FAQ' : 'Home' %>
        </span>
      </div>

      <nav class="hidden md:flex items-center space-x-2">
