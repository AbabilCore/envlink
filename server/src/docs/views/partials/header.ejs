        </a>
        <a
          class="flex items-center gap-1.5 text-xs text-github-textMuted hover:text-github-text no-underline px-3 py-1.5 rounded border border-github-border transition-all duration-150 whitespace-nowrap hover:border-github-textMuted hover:bg-github-hover"
          href="https://www.npmjs.com/package/envlink"
          target="_blank"
