<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-16">
  <div class="bg-github-header border border-github-border rounded-lg p-5 sm:p-8 text-center">
    <div class="mb-4 sm:mb-6">
      <div class="inline-flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-red-500 bg-opacity-10 mb-3 sm:mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500 sm:w-8 sm:h-8">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold text-github-text mb-2">Error <%= error.statusCode %></h1>
      <p class="text-base sm:text-xl text-github-textMuted"><%= error.message %></p>
    </div>

    <% if (error.stack) { %>
      <div class="mt-6 sm:mt-8 text-left">
        <details class="bg-github-bg border border-github-border rounded p-3 sm:p-4">
          <summary class="cursor-pointer text-xs sm:text-sm font-semibold text-github-textMuted hover:text-github-text">Stack Trace (Development Mode)</summary>
          <pre class="mt-3 sm:mt-4 text-[11px] sm:text-xs text-github-textMuted overflow-x-auto"><%= error.stack %></pre>
        </details>
      </div>
    <% } %>

    <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
      <a href="<%= absoluteUrl('/') %>" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3 bg-github-primary text-white text-sm sm:text-base rounded-lg hover:bg-opacity-90 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Go Home
      </a>
      <button onclick="history.back()" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3 border border-github-border text-github-text text-sm sm:text-base rounded-lg hover:bg-github-hover transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Go Back
      </button>
    </div>
  </div>
</div>

<script>
  if (window.pageLoader) pageLoader.hide();
</script>
