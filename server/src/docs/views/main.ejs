<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title><%= title %></title>
    <meta name="title" content="<%= title %>" />
    <meta name="description" content="<%= description %>" />
    <meta name="keywords" content="envlink, environment variables, env files, secure sharing, CLI tool, zero knowledge, password protection, auto expiration, developer tools, .env sharing" />
    <meta name="author" content="EnvLink Team" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="<%= absoluteUrl(canonicalPath) %>" />

    <meta property="og:type" content="<%= page === 'home' ? 'website' : 'article' %>" />
    <meta property="og:url" content="<%= absoluteUrl(canonicalPath) %>" />
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:image" content="<%= absoluteUrl('/image/og-image.png') %>" />
    <meta property="og:site_name" content="EnvLink" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="<%= absoluteUrl(canonicalPath) %>" />
    <meta property="twitter:title" content="<%= title %>" />
    <meta property="twitter:description" content="<%= description %>" />
    <meta property="twitter:image" content="<%= absoluteUrl('/image/og-image.png') %>" />

    <link rel="icon" type="image/png" href="<%= absoluteUrl('/image/favicon.png') %>" />
    <link rel="apple-touch-icon" sizes="180x180" href="<%= absoluteUrl('/image/favicon.png') %>" />
    <link rel="icon" type="image/png" sizes="32x32" href="<%= absoluteUrl('/image/favicon.png') %>" />
    <link rel="icon" type="image/png" sizes="16x16" href="<%= absoluteUrl('/image/favicon.png') %>" />
    <link rel="manifest" href="<%= absoluteUrl('/manifest.json') %>" />

    <meta name="theme-color" content="#58a6ff" />
    <meta name="msapplication-TileColor" content="#0d1117" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.8.1/github-markdown-dark.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css" />
    <link rel="stylesheet" href="<%= absoluteUrl('/style.css') %>" />
    
    <%- include('partials/structuredData', { page }) %>
    <%- include('partials/tailwindConfig') %>
    <%- include('partials/versionSelector') %>
  </head>
  <body class="m-0 bg-github-bg text-github-text font-sans flex flex-col min-h-screen overflow-x-hidden">
    <%- include('partials/pageLoader') %>
    <%- include('partials/header', { page }) %>
    <%- include('partials/breadcrumb') %>

    <main class="flex-grow w-full min-w-0">
      <%- body %>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/mermaidInit') %>
  </body>
</html>
