{
  "name": "envlink",
  "version": "0.1.0",
  "description": "Secure and anonymous environment file sharing CLI",
  "main": "./dist/index.js",
  "bin": {
    "envlink": "./dist/index.js"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx -r tsconfig-paths/register --watch ./src/index.ts",
    "test": "tsx -r tsconfig-paths/register --interactive ./src/index.ts",
    "start": "node ./dist/index.js",
    "update-pkg-meta": "sh scripts/update-pkg.sh",
    "build": "sh ./scripts/build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbabilCore/envlink.git"
  },
  "keywords": [
    "cli",
    "typescript",
    "envlink",
    "environment",
    "env",
    "dotenv",
    "share",
    "secure",
    "anonymous",
    "password-protected",
    "expiration",
    "devtools"
  ],
  "author": "Ababil Hossain <hi@ababilspark.com>",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AbabilCore/envlink/issues"
  },
  "homepage": "https://github.com/AbabilCore/envlink",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^24.13.6",
    "cli-table3": "^0.6.5",
    "colors": "^1.4.0",
    "commander": "^14.0.2",
    "figlet": "^1.9.4",
    "inquirer": "^8.2.7",
    "nanospinner": "^1.2.2",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
