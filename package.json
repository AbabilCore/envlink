{
  "name": "envlink",
  "version": "2.2.4",
  "description": "Secure and anonymous environment file sharing CLI",
  "main": "./dist/index.js",
  "bin": {
    "envlink": "./dist/index.js"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx -r tsconfig-paths/register --watch ./src/index.ts",
    "test": "NODE_ENV=development tsx -r tsconfig-paths/register --interactive ./src/index.ts",
    "test:cli": "python3 scripts/test.py",
    "start": "node ./dist/index.js",
    "build": "sh ./scripts/build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbabilCore/envlink.git"
  },
  "keywords": [
    "cli",
    "envlink",
    "environment",
    "env",
    "dotenv",
    "share",
    "secure",
    "anonymous",
    "password-protected",
    "expiration",
    "devtools"
  ],
  "author": "Ababil Hossain <hi@ababilspark.com>",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AbabilCore/envlink/issues"
  },
  "homepage": "https://envlink.ababilspark.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "commands.md",
    "faq.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.6.4",
    "colors": "^1.4.0",
    "commander": "^15.0.0",
    "inquirer": "^14.2.2",
    "nanospinner": "^1.2.2",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
